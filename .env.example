# PKCS#1 PEM private key used by shairplay for RAOP RSA operations.
# Keep real values in a local .env file (ignored by git).
SHAIRPLAY_RSA_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END RSA PRIVATE KEY-----"

# Optional alternative to SHAIRPLAY_RSA_KEY_PEM:
# SHAIRPLAY_RSA_KEY_PATH=/absolute/path/to/airport.key
